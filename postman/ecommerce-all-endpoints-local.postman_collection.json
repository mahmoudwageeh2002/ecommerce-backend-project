            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Test User\",\n    \"phone\": \"+201001112222\",\n    \"country\": \"Egypt\",\n    \"city\": \"Cairo\",\n    \"street\": \"10 Test Street\",\n    \"postalCode\": \"11511\"\n  },\n  \"paymentMethod\": \"cash\"\n}"
